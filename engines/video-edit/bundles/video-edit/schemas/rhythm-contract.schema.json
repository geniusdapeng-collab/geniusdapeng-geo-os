{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workloom://bundles/video-edit/schemas/rhythm-contract",
  "title": "按需首尾快切输入与内容绑定合同",
  "description": "结构校验之外，执行器还验证保护范围、当前源字节、实际媒体时钟与音乐，不能只凭 schema 通过交付。",
  "type": "object",
  "properties": {
    "rhythm": {
      "$ref": "workloom://bundles/video-edit/schemas/rhythm-contract#/$defs/request"
    }
  },
  "$defs": {
    "durationBand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minSeconds",
        "maxSeconds"
      ],
      "properties": {
        "minSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1800
        },
        "maxSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1800
        }
      }
    },
    "safeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inSeconds",
        "outSeconds",
        "reason"
      ],
      "properties": {
        "inSeconds": {
          "type": "number",
          "minimum": 0
        },
        "outSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "protectedRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inSeconds",
        "outSeconds",
        "reason",
        "kind"
      ],
      "properties": {
        "inSeconds": {
          "type": "number",
          "minimum": 0
        },
        "outSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "speech",
            "action"
          ]
        }
      }
    },
    "shotFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligibleFor",
        "speechReviewed",
        "actionReviewed",
        "safeRanges"
      ],
      "properties": {
        "eligibleFor": {
          "type": "array",
          "items": {
            "enum": [
              "opening",
              "ending"
            ]
          },
          "uniqueItems": true
        },
        "speechReviewed": {
          "type": "boolean"
        },
        "actionReviewed": {
          "type": "boolean"
        },
        "safeRanges": {
          "type": "array",
          "items": {
            "$ref": "workloom://bundles/video-edit/schemas/rhythm-contract#/$defs/safeRange"
          },
          "maxItems": 1000
        },
        "doNotCut": {
          "type": "array",
          "items": {
            "$ref": "workloom://bundles/video-edit/schemas/rhythm-contract#/$defs/protectedRange"
          }
        },
        "mustKeep": {
          "type": "array",
          "items": {
            "$ref": "workloom://bundles/video-edit/schemas/rhythm-contract#/$defs/protectedRange"
          }
        }
      }
    },
    "endIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "energy",
        "reason"
      ],
      "properties": {
        "purpose": {
          "enum": [
            "hook",
            "preview",
            "action",
            "recap",
            "payoff",
            "dialogue",
            "reflection",
            "natural"
          ]
        },
        "energy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "musicRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "trackId": {
          "type": "string",
          "minLength": 1
        },
        "sectionStartSeconds": {
          "type": "number",
          "minimum": 0
        },
        "sectionEndSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "entrySeconds": {
          "type": "number",
          "minimum": 0
        },
        "repeat": {
          "type": "boolean"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "bookends",
            "opening",
            "ending",
            "natural"
          ]
        },
        "opening": {
          "$ref": "workloom://bundles/video-edit/schemas/rhythm-contract#/$defs/endIntent"
        },
        "ending": {
          "$ref": "workloom://bundles/video-edit/schemas/rhythm-contract#/$defs/endIntent"
        },
        "durationBand": {
          "$ref": "workloom://bundles/video-edit/schemas/rhythm-contract#/$defs/durationBand"
        },
        "clipCount": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        },
        "clipSeconds": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 1.2
        },
        "minLandingSeconds": {
          "type": "number",
          "minimum": 1.5,
          "maximum": 20
        },
        "beatSync": {
          "type": "boolean"
        },
        "music": {
          "$ref": "workloom://bundles/video-edit/schemas/rhythm-contract#/$defs/musicRequest"
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "path",
        "sha256",
        "trackId",
        "durationSeconds",
        "onsetTimesSeconds",
        "method",
        "source"
      ],
      "properties": {
        "schemaVersion": {
          "const": "workloom.video-edit/rhythm-music/v1"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "trackId": {
          "type": "string",
          "minLength": 1
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "onsetTimesSeconds": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "trackId",
            "license",
            "sectionStartSeconds",
            "sectionEndSeconds",
            "entrySeconds",
            "repeat"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "trackId": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "sectionStartSeconds": {
              "type": "number",
              "minimum": 0
            },
            "sectionEndSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "entrySeconds": {
              "type": "number",
              "minimum": 0
            },
            "repeat": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "clockEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentId",
        "startSeconds",
        "endSeconds",
        "overlapSeconds",
        "concatStartSeconds",
        "concatEndSeconds"
      ],
      "properties": {
        "segmentId": {
          "type": "string",
          "minLength": 1
        },
        "startSeconds": {
          "type": "number",
          "minimum": 0
        },
        "endSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "overlapSeconds": {
          "type": "number",
          "minimum": 0
        },
        "concatStartSeconds": {
          "type": "number",
          "minimum": 0
        },
        "concatEndSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentId",
        "sourceId",
        "shotId",
        "end",
        "sourceIn",
        "sourceOut",
        "reason"
      ],
      "properties": {
        "segmentId": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "shotId": {
          "type": "string",
          "minLength": 1
        },
        "end": {
          "enum": [
            "opening",
            "ending"
          ]
        },
        "sourceIn": {
          "type": "number",
          "minimum": 0
        },
        "sourceOut": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inSeconds",
        "outSeconds",
        "reason",
        "kind",
        "sourceId",
        "mustKeep"
      ],
      "properties": {
        "inSeconds": {
          "type": "number",
          "minimum": 0
        },
        "outSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "speech",
            "action"
          ]
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "mustKeep": {
          "type": "boolean"
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "end",
        "segmentIds",
        "startSeconds",
        "endSeconds",
        "cutTimesSeconds"
      ],
      "properties": {
        "end": {
          "enum": [
            "opening",
            "ending"
          ]
        },
        "segmentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 6
        },
        "startSeconds": {
          "type": "number",
          "minimum": 0
        },
        "endSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cutTimesSeconds": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 6
        }
      }
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestedMode",
        "mode",
        "reasons",
        "originalTimelineSha256",
        "timelineSha256",
        "storySha256",
        "analysesSha256",
        "originalSegmentIds",
        "selections",
        "protections",
        "durationBand",
        "clipCount",
        "minLandingSeconds",
        "regions",
        "clock",
        "expectedOutputSeconds",
        "transitionMode",
        "beatSync",
        "music",
        "artisticQuality"
      ],
      "properties": {
        "schemaVersion": {
          "const": "workloom.video-edit/rhythm-direction/v1"
        },
        "requestedMode": {
          "enum": [
            "auto",
            "bookends",
            "opening",
            "ending",
            "natural"
          ]
        },
        "mode": {
          "enum": [
            "bookends",
            "opening",
            "ending",
            "natural"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "originalTimelineSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "timelineSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "storySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "analysesSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "originalSegmentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "selections": {
          "type": "array",
          "items": {
            "$ref": "workloom://bundles/video-edit/schemas/rhythm-contract#/$defs/selection"
          }
        },
        "protections": {
          "type": "array",
          "items": {
            "$ref": "workloom://bundles/video-edit/schemas/rhythm-contract#/$defs/protection"
          }
        },
        "durationBand": {
          "$ref": "workloom://bundles/video-edit/schemas/rhythm-contract#/$defs/durationBand"
        },
        "clipCount": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        },
        "minLandingSeconds": {
          "type": "number",
          "minimum": 1.5,
          "maximum": 20
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "workloom://bundles/video-edit/schemas/rhythm-contract#/$defs/region"
          },
          "maxItems": 2
        },
        "clock": {
          "type": "array",
          "items": {
            "$ref": "workloom://bundles/video-edit/schemas/rhythm-contract#/$defs/clockEntry"
          },
          "minItems": 1,
          "maxItems": 2000
        },
        "expectedOutputSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1800
        },
        "transitionMode": {
          "const": "declared"
        },
        "beatSync": {
          "type": "boolean"
        },
        "music": {
          "anyOf": [
            {
              "$ref": "workloom://bundles/video-edit/schemas/rhythm-contract#/$defs/music"
            },
            {
              "type": "null"
            }
          ]
        },
        "artisticQuality": {
          "const": "unverified"
        }
      }
    },
    "planSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceId",
        "inSeconds",
        "outSeconds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "inSeconds": {
          "type": "number",
          "minimum": 0
        },
        "outSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "role": {
          "enum": [
            "fast",
            "hold",
            "breath",
            "story"
          ]
        },
        "cutReason": {
          "type": "string",
          "minLength": 1
        },
        "beatIndex": {
          "type": "integer",
          "minimum": 0
        },
        "protectedRanges": {
          "type": "array",
          "items": {
            "$ref": "workloom://bundles/video-edit/schemas/rhythm-contract#/$defs/protectedRange"
          }
        },
        "lockTrim": {
          "type": "boolean"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segments"
      ],
      "properties": {
        "profile": {
          "enum": [
            "natural",
            "fast-cut",
            "cinematic"
          ]
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "workloom://bundles/video-edit/schemas/rhythm-contract#/$defs/planSegment"
          },
          "minItems": 1,
          "maxItems": 2000
        },
        "beatEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "sourceSha256",
            "method",
            "beatTimesSeconds"
          ],
          "properties": {
            "status": {
              "enum": [
                "measured",
                "unverified"
              ]
            },
            "sourceSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "beatTimesSeconds": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "soundCues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "atSeconds",
              "kind",
              "reason"
            ],
            "properties": {
              "atSeconds": {
                "type": "number",
                "minimum": 0
              },
              "kind": {
                "enum": [
                  "impact",
                  "whoosh",
                  "ambience",
                  "silence",
                  "music-entry",
                  "music-exit"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "gainDb": {
                "type": "number",
                "minimum": -60,
                "maximum": 0
              }
            }
          }
        },
        "beatToleranceSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2
        }
      }
    }
  }
}
