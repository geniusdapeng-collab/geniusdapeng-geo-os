{
  "schemaVersion": "workloom.transition-catalog/v1",
  "updatedAt": "2026-10-11",
  "engine": {
    "name": "ffmpeg-xfade",
    "filter": "xfade",
    "audioFilter": "acrossfade",
    "minVersion": "6.0",
    "customExprMinVersion": "5.1",
    "customExprVars": ["X", "Y", "W", "H", "P", "PLANE", "A", "B"],
    "note": "命名转场直接使用 FFmpeg xfade 内置实现（零新依赖、纯 CPU、4K 可跑）；custom 表达式用于逐像素缓动叠化，代价是每像素求值（实测 4K 约 7 倍耗时），仅在显式开启 easing=smooth 时使用。"
  },
  "sources": [
    {
      "name": "FFmpeg xfade",
      "url": "https://github.com/FFmpeg/FFmpeg",
      "path": "libavfilter/vf_xfade.c",
      "license": "LGPL-2.1-or-later / GPL（按编译配置）",
      "role": "默认引擎：命名转场 + custom 表达式",
      "verifiedAt": "2026-10-11",
      "evidence": "本机 ffmpeg 6.0 -h filter=xfade 实测 46 种命名转场 + custom；对照 FFmpeg master 源码 doc/filters.texi 的 custom 变量表（X/Y/W/H/P/PLANE/A/B）"
    },
    {
      "name": "gl-transitions",
      "url": "https://github.com/gl-transitions/gl-transitions",
      "license": "MIT（集合）",
      "role": "备选引擎（未集成）：100+ GLSL 着色器转场集合",
      "verifiedAt": "2026-10-11",
      "evidence": "GitHub API：2149 stars，最近推送 2026-10-10；需要 GL 渲染器（浏览器 WebGL 或 headless-gl）才能落地，见 docs/video-edit-transitions.md 的方案对比"
    },
    {
      "name": "ffmpeg-gl-transition",
      "url": "https://github.com/transitive-bullshit/ffmpeg-gl-transition",
      "license": "未声明（仓库根 LICENSE 缺失）",
      "role": "备选引擎（未集成）：给 FFmpeg 加 gltransition 滤镜的补丁",
      "verifiedAt": "2026-10-11",
      "evidence": "GitHub API：720 stars，最近推送 2024-07-23；要求自编译 FFmpeg，无官方预编译产物；见方案对比"
    }
  ],
  "durationPolicy": {
    "minSec": 0.15,
    "maxSec": 2,
    "maxShareOfClip": 0.3333,
    "minFrames": 2,
    "note": "上限 2s 与 edit-timeline 契约一致（timeline.ts#MAX_TRANSITION_SECONDS）；下限取 0.15s 与 2 帧的较大者；转场最多吃掉相邻较短镜头的 1/3，否则降级硬切"
  },
  "intents": {
    "cut": { "type": null, "durationSec": 0, "easing": "native", "note": "硬切：不进入转场渲染，拼接点保持帧精确" },
    "dissolve": { "type": "fade", "durationSec": 0.5, "easing": "native", "fallbackType": "fade", "note": "叠化：叙事最通用的情绪过渡" },
    "fade_from_black": { "type": "fadeblack", "durationSec": 0.5, "easing": "native", "fallbackType": "fade", "blackDip": true, "note": "黑场进入：仅用于时间/空间跳变，绝不作为镜头间默认转场" },
    "fade_to_black": { "type": "fadeblack", "durationSec": 0.5, "easing": "native", "fallbackType": "fade", "blackDip": true, "note": "黑场收束：段尾/片尾使用" },
    "wipe": {
      "type": "wipeleft",
      "durationSec": 0.4,
      "easing": "native",
      "fallbackType": "wipeleft",
      "directions": { "left": "wipeleft", "right": "wiperight", "up": "wipeup", "down": "wipedown" },
      "note": "方向擦除：默认左向；params.direction 可指定 left/right/up/down"
    },
    "match_cut": { "type": null, "durationSec": 0, "easing": "native", "note": "匹配剪辑：动作/形状对齐，必须硬切，不做混合" },
    "jump_cut": { "type": null, "durationSec": 0, "easing": "native", "note": "跳切：口播/快节奏，必须硬切" },
    "whip_pan": {
      "type": "smoothleft",
      "durationSec": 0.25,
      "easing": "native",
      "fallbackType": "slideleft",
      "directions": { "left": "smoothleft", "right": "smoothright", "up": "smoothup", "down": "smoothdown" },
      "note": "甩镜感：短视频快节奏转场；保持 ≤0.35s，过长会像幻灯片"
    },
    "zoom_blur": {
      "type": "zoomin",
      "durationSec": 0.3,
      "easing": "native",
      "fallbackType": "hblur",
      "note": "推近/模糊感：产品与动作爆点；zoomin 自带 smoothstep 曲线（FFmpeg 6.0 起）"
    }
  },
  "packs": {
    "documentary": { "sceneIntent": "dissolve", "scale": 1.15, "note": "纪实/文旅：场景切换用慢叠化，镜头内保持硬切" },
    "vlog": { "sceneIntent": "whip_pan", "scale": 1.0, "note": "生活 Vlog：场景切换用柔边推移（甩镜感），镜头内硬切" },
    "fast_cut": { "sceneIntent": "wipe", "scale": 0.7, "note": "快剪/卡点：场景切换用短擦除，其余硬切" },
    "information": { "sceneIntent": "dissolve", "scale": 0.8, "note": "信息流/产品：场景切换用短叠化，信息优先" },
    "talk": { "sceneIntent": "dissolve", "scale": 0.8, "note": "口播精剪：段内句子级硬切（跳切），仅话题/场景切换用一次短叠化" }
  },
