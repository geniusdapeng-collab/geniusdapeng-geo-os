2026-11-02T15:34:32.1129520Z  	  created_at        TIMESTAMPTZ NOT NULL DEFAULT now(),
2026-11-02T15:34:32.1129702Z  	  UNIQUE (rule_id, version, workspace_id)
2026-11-02T15:34:32.1129848Z  	);
