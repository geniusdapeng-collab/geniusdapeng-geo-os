2026-11-02T15:34:32.1051575Z  	-- append-only 防改写触发器（L1.1：回滚/删除均为新事件，原事件永不修改）
2026-11-02T15:34:32.1051789Z  	CREATE OR REPLACE FUNCTION workloom_no_mutate() RETURNS trigger AS $$
2026-11-02T15:34:32.1051983Z  	BEGIN
2026-11-02T15:34:32.1052156Z  	  RAISE EXCEPTION 'biz_events is append-only: % not allowed (PRD L1.1)', TG_OP;
2026-11-02T15:34:32.1052366Z  	END;
2026-11-02T15:34:32.1052475Z  	$$ LANGUAGE plpgsql;
2026-11-02T15:34:32.1052596Z  	
2026-11-02T15:34:32.1052709Z  	CREATE TRIGGER trg_biz_events_no_update
2026-11-02T15:34:32.1053032Z  	  BEFORE UPDATE ON biz_events FOR EACH ROW EXECUTE FUNCTION workloom_no_mutate();
2026-11-02T15:34:32.1053257Z  	CREATE TRIGGER trg_biz_events_no_delete
2026-11-02T15:34:32.1053473Z  	  BEFORE DELETE ON biz_events FOR EACH ROW EXECUTE FUNCTION workloom_no_mutate();
