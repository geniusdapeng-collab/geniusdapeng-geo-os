2026-11-02T15:34:32.1104366Z  	  status      TEXT NOT NULL DEFAULT 'active',
2026-11-02T15:34:32.1104550Z  	  created_at  TIMESTAMPTZ NOT NULL DEFAULT now()
2026-11-02T15:34:32.1104711Z  	);
2026-11-02T15:34:32.1104809Z  	
2026-11-02T15:34:32.1104913Z  	CREATE TABLE workspaces (
2026-11-02T15:34:32.1105051Z  	  id            TEXT PRIMARY KEY,
2026-11-02T15:34:32.1105212Z  	  tenant_id     TEXT NOT NULL REFERENCES tenants(id),
2026-11-02T15:34:32.1105388Z  	  name          TEXT NOT NULL,
2026-11-02T15:34:32.1105528Z  	  slug          TEXT NOT NULL UNIQUE,
2026-11-02T15:34:32.1105748Z  	  industry      TEXT NOT NULL DEFAULT 'hotel',                        -- §2.2 装配槽：行业 bundle 名
2026-11-02T15:34:32.1106011Z  	  stage         TEXT,                                                 -- 经营阶段（枚举行业化）
2026-11-02T15:34:32.1106262Z  	  night_config  JSONB NOT NULL DEFAULT '{}',                          -- F4.8 夜班配置
2026-11-02T15:34:32.1106502Z  	  created_at    TIMESTAMPTZ NOT NULL DEFAULT now()
2026-11-02T15:34:32.1106667Z  	);
2026-11-02T15:34:32.1106765Z  	
2026-11-02T15:34:32.1106921Z  	CREATE TABLE members (                                                -- 人类成员（F5.6）
2026-11-02T15:34:32.1107125Z  	  id            TEXT PRIMARY KEY,
2026-11-02T15:34:32.1107298Z  	  workspace_id  TEXT NOT NULL REFERENCES workspaces(id),
2026-11-02T15:34:32.1107527Z  	  member_no     TEXT NOT NULL,                                        -- MEM-041
2026-11-02T15:34:32.1107738Z  	  name          TEXT NOT NULL,
2026-11-02T15:34:32.1107889Z  	  role          TEXT NOT NULL DEFAULT 'readonly'
2026-11-02T15:34:32.1108098Z  	                CHECK (role IN ('owner','manager','readonly','group','channel')),
2026-11-02T15:34:32.1108368Z  	  im_openids    JSONB NOT NULL DEFAULT '{}',                          -- openid→成员映射（E5.2）
2026-11-02T15:34:32.1108613Z  	  created_at    TIMESTAMPTZ NOT NULL DEFAULT now(),
2026-11-02T15:34:32.1108786Z  	  UNIQUE (workspace_id, member_no)
2026-11-02T15:34:32.1108929Z  	);
2026-11-02T15:34:32.1109029Z  	
2026-11-02T15:34:32.1109188Z  	CREATE TABLE agents (                                                 -- Agent 一等公民（IM.5）
2026-11-02T15:34:32.1109401Z  	  id              TEXT PRIMARY KEY,
2026-11-02T15:34:32.1109580Z  	  workspace_id    TEXT NOT NULL REFERENCES workspaces(id),
2026-11-02T15:34:32.1109764Z  	  preset_key      TEXT NOT NULL,
2026-11-02T15:34:32.1109904Z  	  name            TEXT NOT NULL,
2026-11-02T15:34:32.1110188Z  	  version         TEXT NOT NULL,                                      -- who.version 归因必需
2026-11-02T15:34:32.1110395Z  	  kind            TEXT NOT NULL,
2026-11-02T15:34:32.1110601Z  	  readonly        BOOLEAN NOT NULL DEFAULT false,                     -- L9.1 只读 preset
2026-11-02T15:34:32.1110998Z  	  fence_bindings  JSONB NOT NULL DEFAULT '[]',                        -- F2.10 未声明即禁写
2026-11-02T15:34:32.1111363Z  	  skills          JSONB NOT NULL DEFAULT '[]',
2026-11-02T15:34:32.1111643Z  	  status          TEXT NOT NULL DEFAULT 'ready'
2026-11-02T15:34:32.1111833Z  	                  CHECK (status IN ('ready','disabled','invalid')),
2026-11-02T15:34:32.1112012Z  	  invalid_reason  TEXT,
2026-11-02T15:34:32.1112152Z  	  meta            JSONB NOT NULL DEFAULT '{}',
2026-11-02T15:34:32.1112333Z  	  created_at      TIMESTAMPTZ NOT NULL DEFAULT now()
2026-11-02T15:34:32.1112495Z  	);
