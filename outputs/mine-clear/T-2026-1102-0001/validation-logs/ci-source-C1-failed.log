2026-11-02T15:34:32.1027610Z  2026-11-02 15:34:28.257 UTC [273] STATEMENT:  -- ============================================================================
2026-11-02T15:34:32.1028010Z  	-- WorkLoom IM 底座 · 0001_init.sql
2026-11-02T15:34:32.1028481Z  	-- DDL 事实源（手写 SQL 入库可审计；packages/db/src/schema.ts 仅为类型镜像）
2026-11-02T15:34:32.1028831Z  	-- 对齐：PRD V2.5 附录 E（五元事件 Schema）/ L1.1（append-only）/ F1.2（仅网关可写）
2026-11-02T15:34:32.1029130Z  	--      / F7.1（RLS 行级隔离）/ L7.1（越权返回空而非 403）
2026-11-02T15:34:32.1029409Z  	-- 执行前提：migrate.ts 已创建 workloom_app / workloom_gateway 两个角色
2026-11-02T15:34:32.1029715Z  	-- ============================================================================
2026-11-02T15:34:32.1029976Z  	
2026-11-02T15:34:32.1030284Z  	CREATE EXTENSION IF NOT EXISTS vector;
2026-11-02T15:34:32.1030510Z  	
2026-11-02T15:34:32.1030728Z  	-- ---------- 组织模型（M7） ----------
2026-11-02T15:34:32.1031038Z  	
2026-11-02T15:34:32.1031199Z  	CREATE TABLE tenants (
2026-11-02T15:34:32.1031404Z  	  id          TEXT PRIMARY KEY,
2026-11-02T15:34:32.1031619Z  	  name        TEXT NOT NULL,
2026-11-02T15:34:32.1031845Z  	  plan        TEXT NOT NULL DEFAULT 'pro'
2026-11-02T15:34:32.1032182Z  	              CHECK (plan IN ('community','pro','teams','vpc')),      -- F7.2 版本能力矩阵
2026-11-02T15:34:32.1032522Z  	  status      TEXT NOT NULL DEFAULT 'active',
2026-11-02T15:34:32.1032826Z  	  created_at  TIMESTAMPTZ NOT NULL DEFAULT now()
2026-11-02T15:34:32.1033080Z  	);
2026-11-02T15:34:32.1033235Z  	
2026-11-02T15:34:32.1033404Z  	CREATE TABLE workspaces (
2026-11-02T15:34:32.1033612Z  	  id            TEXT PRIMARY KEY,
2026-11-02T15:34:32.1033865Z  	  tenant_id     TEXT NOT NULL REFERENCES tenants(id),
2026-11-02T15:34:32.1034126Z  	  name          TEXT NOT NULL,
2026-11-02T15:34:32.1034394Z  	  slug          TEXT NOT NULL UNIQUE,
2026-11-02T15:34:32.1034743Z  	  industry      TEXT NOT NULL DEFAULT 'hotel',                        -- §2.2 装配槽：行业 bundle 名
2026-11-02T15:34:32.1035146Z  	  stage         TEXT,                                                 -- 经营阶段（枚举行业化）
2026-11-02T15:34:32.1035536Z  	  night_config  JSONB NOT NULL DEFAULT '{}',                          -- F4.8 夜班配置
2026-11-02T15:34:32.1035900Z  	  created_at    TIMESTAMPTZ NOT NULL DEFAULT now()
2026-11-02T15:34:32.1036158Z  	);
2026-11-02T15:34:32.1036314Z  	
2026-11-02T15:34:32.1036560Z  	CREATE TABLE members (                                                -- 人类成员（F5.6）
2026-11-02T15:34:32.1036874Z  	  id            TEXT PRIMARY KEY,
2026-11-02T15:34:32.1037144Z  	  workspace_id  TEXT NOT NULL REFERENCES workspaces(id),
2026-11-02T15:34:32.1037488Z  	  member_no     TEXT NOT NULL,                                        -- MEM-041
2026-11-02T15:34:32.1037787Z  	  name          TEXT NOT NULL,
2026-11-02T15:34:32.1038020Z  	  role          TEXT NOT NULL DEFAULT 'readonly'
2026-11-02T15:34:32.1038340Z  	                CHECK (role IN ('owner','manager','readonly','group','channel')),
2026-11-02T15:34:32.1038749Z  	  im_openids    JSONB NOT NULL DEFAULT '{}',                          -- openid→成员映射（E5.2）
2026-11-02T15:34:32.1039114Z  	  created_at    TIMESTAMPTZ NOT NULL DEFAULT now(),
2026-11-02T15:34:32.1039372Z  	  UNIQUE (workspace_id, member_no)
2026-11-02T15:34:32.1039580Z  	);
2026-11-02T15:34:32.1039734Z  	
2026-11-02T15:34:32.1039978Z  	CREATE TABLE agents (                                                 -- Agent 一等公民（IM.5）
2026-11-02T15:34:32.1040297Z  	  id              TEXT PRIMARY KEY,
2026-11-02T15:34:32.1040566Z  	  workspace_id    TEXT NOT NULL REFERENCES workspaces(id),
2026-11-02T15:34:32.1040839Z  	  preset_key      TEXT NOT NULL,
2026-11-02T15:34:32.1041167Z  	  name            TEXT NOT NULL,
2026-11-02T15:34:32.1041471Z  	  version         TEXT NOT NULL,                                      -- who.version 归因必需
2026-11-02T15:34:32.1042200Z  	  kind            TEXT NOT NULL,
2026-11-02T15:34:32.1042523Z  	  readonly        BOOLEAN NOT NULL DEFAULT false,                     -- L9.1 只读 preset
2026-11-02T15:34:32.1042954Z  	  fence_bindings  JSONB NOT NULL DEFAULT '[]',                        -- F2.10 未声明即禁写
2026-11-02T15:34:32.1043310Z  	  skills          JSONB NOT NULL DEFAULT '[]',
2026-11-02T15:34:32.1043523Z  	  status          TEXT NOT NULL DEFAULT 'ready'
2026-11-02T15:34:32.1043887Z  	                  CHECK (status IN ('ready','disabled','invalid')),
2026-11-02T15:34:32.1044068Z  	  invalid_reason  TEXT,
2026-11-02T15:34:32.1044212Z  	  meta            JSONB NOT NULL DEFAULT '{}',
2026-11-02T15:34:32.1044392Z  	  created_at      TIMESTAMPTZ NOT NULL DEFAULT now()
2026-11-02T15:34:32.1044550Z  	);
2026-11-02T15:34:32.1044648Z  	
2026-11-02T15:34:32.1044766Z  	-- ---------- 消息总线层（M1） ----------
2026-11-02T15:34:32.1044903Z  	
2026-11-02T15:34:32.1045064Z  	CREATE TABLE profiles (                                               -- 一 X 一档（槽①）
2026-11-02T15:34:32.1045310Z  	  workspace_id  TEXT PRIMARY KEY REFERENCES workspaces(id),
2026-11-02T15:34:32.1045516Z  	  tenant_id     TEXT NOT NULL REFERENCES tenants(id),
2026-11-02T15:34:32.1045688Z  	  industry      TEXT NOT NULL,
2026-11-02T15:34:32.1045830Z  	  archive       JSONB NOT NULL,
2026-11-02T15:34:32.1046036Z  	  forbidden     JSONB NOT NULL DEFAULT '[]',                          -- 禁用承诺，硬约束（L1.6）
2026-11-02T15:34:32.1046307Z  	  pii_vault     JSONB,                                                -- F1.10 PII 保险柜（密文）
2026-11-02T15:34:32.1046665Z  	  updated_at    TIMESTAMPTZ NOT NULL DEFAULT now()
2026-11-02T15:34:32.1046826Z  	);
2026-11-02T15:34:32.1046922Z  	
2026-11-02T15:34:32.1047094Z  	CREATE TABLE biz_events (                                             -- 五元事件库（append-only）
2026-11-02T15:34:32.1047438Z  	  seq           BIGSERIAL PRIMARY KEY,                                -- 服务端单调递增（L1.4）
2026-11-02T15:34:32.1047706Z  	  event_id      TEXT NOT NULL,                                        -- E-88xx
2026-11-02T15:34:32.1047906Z  	  tenant_id     TEXT NOT NULL,
2026-11-02T15:34:32.1048043Z  	  workspace_id  TEXT NOT NULL,
2026-11-02T15:34:32.1048224Z  	  session_id    TEXT,                                                 -- 会话=线程（IM.3）
2026-11-02T15:34:32.1048479Z  	  payload       JSONB NOT NULL,                                       -- 完整五元消息（zod 校验后写入）
2026-11-02T15:34:32.1048687Z  	  prev_hash     TEXT NOT NULL,
2026-11-02T15:34:32.1048894Z  	  hash          TEXT NOT NULL,                                        -- sha256(prev_hash || payload)
2026-11-02T15:34:32.1049128Z  	  created_at    TIMESTAMPTZ NOT NULL DEFAULT now(),
2026-11-02T15:34:32.1049357Z  	  UNIQUE (tenant_id, event_id)                                        -- 幂等键：重复写入丢弃（L1.4）
2026-11-02T15:34:32.1049559Z  	);
2026-11-02T15:34:32.1049662Z  	
2026-11-02T15:34:32.1049831Z  	CREATE INDEX idx_events_ws_time ON biz_events (workspace_id, created_at DESC);
2026-11-02T15:34:32.1050164Z  	CREATE INDEX idx_events_object  ON biz_events ((payload->'object'->>'type'), (payload->'object'->>'id'));
