2026-11-02T15:34:32.1229261Z  	  skills, skill_installs, industry_assets, credentials
2026-11-02T15:34:32.1229373Z  	TO workloom_app;
2026-11-02T15:34:32.1229443Z  	GRANT SELECT ON biz_events TO workloom_app;
2026-11-02T15:34:32.1229483Z  	
2026-11-02T15:34:32.1229543Z  	GRANT SELECT, INSERT, UPDATE, DELETE ON
2026-11-02T15:34:32.1229615Z  	  tenants, workspaces, members, agents, profiles,
2026-11-02T15:34:32.1229690Z  	  org_memory, memory_usage, fence_rules, fence_dry_runs,
2026-11-02T15:34:32.1229754Z  	  threads, approvals, night_runs, triggers,
2026-11-02T15:34:32.1229882Z  	  skills, skill_installs, industry_assets, credentials
2026-11-02T15:34:32.1229935Z  	TO workloom_gateway;
