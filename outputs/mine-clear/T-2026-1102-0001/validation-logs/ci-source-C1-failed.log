2026-11-02T15:34:32.1125858Z  	-- ---------- 行动权限层（M2） ----------
2026-11-02T15:34:32.1125991Z  	
2026-11-02T15:34:32.1126151Z  	CREATE TABLE fence_rules (                                            -- 围栏规则（版本化 F2.4）
2026-11-02T15:34:32.1126363Z  	  id                TEXT PRIMARY KEY,
2026-11-02T15:34:32.1126560Z  	  rule_id           TEXT NOT NULL,                                    -- R1…R6
2026-11-02T15:34:32.1126756Z  	  version           TEXT NOT NULL,
2026-11-02T15:34:32.1126956Z  	  workspace_id      TEXT NOT NULL DEFAULT '*',                        -- '*' = 全局/行业基线
2026-11-02T15:34:32.1127167Z  	  name              TEXT NOT NULL,
