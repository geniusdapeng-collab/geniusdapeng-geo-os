2026-11-02T15:34:32.1194575Z  	CREATE TABLE biz_events (                                             -- 五元事件库（append-only）
2026-11-02T15:34:32.1194845Z  	  seq           BIGSERIAL PRIMARY KEY,                                -- 服务端单调递增（L1.4）
2026-11-02T15:34:32.1195101Z  	  event_id      TEXT NOT NULL,                                        -- E-88xx
2026-11-02T15:34:32.1195297Z  	  tenant_id     TEXT NOT NULL,
2026-11-02T15:34:32.1195438Z  	  workspace_id  TEXT NOT NULL,
2026-11-02T15:34:32.1195617Z  	  session_id    TEXT,                                                 -- 会话=线程（IM.3）
2026-11-02T15:34:32.1195876Z  	  payload       JSONB NOT NULL,                                       -- 完整五元消息（zod 校验后写入）
2026-11-02T15:34:32.1196083Z  	  prev_hash     TEXT NOT NULL,
2026-11-02T15:34:32.1196283Z  	  hash          TEXT NOT NULL,                                        -- sha256(prev_hash || payload)
2026-11-02T15:34:32.1196514Z  	  created_at    TIMESTAMPTZ NOT NULL DEFAULT now(),
2026-11-02T15:34:32.1196745Z  	  UNIQUE (tenant_id, event_id)                                        -- 幂等键：重复写入丢弃（L1.4）
2026-11-02T15:34:32.1196946Z  	);
2026-11-02T15:34:32.1197047Z  	
2026-11-02T15:34:32.1197221Z  	CREATE INDEX idx_events_ws_time ON biz_events (workspace_id, created_at DESC);
2026-11-02T15:34:32.1197550Z  	CREATE INDEX idx_events_object  ON biz_events ((payload->'object'->>'type'), (payload->'object'->>'id'));
2026-11-02T15:34:32.1197874Z  	CREATE INDEX idx_events_action  ON biz_events ((payload->'decision'->>'action'));
2026-11-02T15:34:32.1198145Z  	CREATE INDEX idx_events_session ON biz_events (session_id, created_at);
2026-11-02T15:34:32.1198444Z  	CREATE INDEX idx_events_rule    ON biz_events USING GIN ((payload->'rule_impact'));  -- G1 ≤3s 机制
2026-11-02T15:34:32.1198675Z  	
2026-11-02T15:34:32.1198802Z  	-- append-only 防改写触发器（L1.1：回滚/删除均为新事件，原事件永不修改）
2026-11-02T15:34:32.1199013Z  	CREATE OR REPLACE FUNCTION workloom_no_mutate() RETURNS trigger AS $$
2026-11-02T15:34:32.1199207Z  	BEGIN
2026-11-02T15:34:32.1199378Z  	  RAISE EXCEPTION 'biz_events is append-only: % not allowed (PRD L1.1)', TG_OP;
2026-11-02T15:34:32.1199584Z  	END;
2026-11-02T15:34:32.1199791Z  	$$ LANGUAGE plpgsql;
2026-11-02T15:34:32.1199909Z  	
2026-11-02T15:34:32.1200024Z  	CREATE TRIGGER trg_biz_events_no_update
2026-11-02T15:34:32.1200240Z  	  BEFORE UPDATE ON biz_events FOR EACH ROW EXECUTE FUNCTION workloom_no_mutate();
2026-11-02T15:34:32.1200464Z  	CREATE TRIGGER trg_biz_events_no_delete
2026-11-02T15:34:32.1200677Z  	  BEFORE DELETE ON biz_events FOR EACH ROW EXECUTE FUNCTION workloom_no_mutate();
2026-11-02T15:34:32.1200990Z  	
