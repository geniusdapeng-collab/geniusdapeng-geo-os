2026-11-02T15:34:32.1112997Z  	CREATE TABLE profiles (                                               -- 一 X 一档（槽①）
2026-11-02T15:34:32.1113237Z  	  workspace_id  TEXT PRIMARY KEY REFERENCES workspaces(id),
2026-11-02T15:34:32.1113441Z  	  tenant_id     TEXT NOT NULL REFERENCES tenants(id),
2026-11-02T15:34:32.1113614Z  	  industry      TEXT NOT NULL,
2026-11-02T15:34:32.1113755Z  	  archive       JSONB NOT NULL,
2026-11-02T15:34:32.1113961Z  	  forbidden     JSONB NOT NULL DEFAULT '[]',                          -- 禁用承诺，硬约束（L1.6）
2026-11-02T15:34:32.1114227Z  	  pii_vault     JSONB,                                                -- F1.10 PII 保险柜（密文）
2026-11-02T15:34:32.1114450Z  	  updated_at    TIMESTAMPTZ NOT NULL DEFAULT now()
2026-11-02T15:34:32.1114608Z  	);
2026-11-02T15:34:32.1114708Z  	
2026-11-02T15:34:32.1114873Z  	CREATE TABLE biz_events (                                             -- 五元事件库（append-only）
2026-11-02T15:34:32.1115141Z  	  seq           BIGSERIAL PRIMARY KEY,                                -- 服务端单调递增（L1.4）
2026-11-02T15:34:32.1115398Z  	  event_id      TEXT NOT NULL,                                        -- E-88xx
2026-11-02T15:34:32.1115593Z  	  tenant_id     TEXT NOT NULL,
2026-11-02T15:34:32.1115731Z  	  workspace_id  TEXT NOT NULL,
2026-11-02T15:34:32.1115918Z  	  session_id    TEXT,                                                 -- 会话=线程（IM.3）
2026-11-02T15:34:32.1116168Z  	  payload       JSONB NOT NULL,                                       -- 完整五元消息（zod 校验后写入）
2026-11-02T15:34:32.1116381Z  	  prev_hash     TEXT NOT NULL,
2026-11-02T15:34:32.1116580Z  	  hash          TEXT NOT NULL,                                        -- sha256(prev_hash || payload)
2026-11-02T15:34:32.1116814Z  	  created_at    TIMESTAMPTZ NOT NULL DEFAULT now(),
2026-11-02T15:34:32.1117047Z  	  UNIQUE (tenant_id, event_id)                                        -- 幂等键：重复写入丢弃（L1.4）
2026-11-02T15:34:32.1117251Z  	);
2026-11-02T15:34:32.1117346Z  	
2026-11-02T15:34:32.1117516Z  	CREATE INDEX idx_events_ws_time ON biz_events (workspace_id, created_at DESC);
2026-11-02T15:34:32.1117848Z  	CREATE INDEX idx_events_object  ON biz_events ((payload->'object'->>'type'), (payload->'object'->>'id'));
2026-11-02T15:34:32.1118173Z  	CREATE INDEX idx_events_action  ON biz_events ((payload->'decision'->>'action'));
2026-11-02T15:34:32.1118448Z  	CREATE INDEX idx_events_session ON biz_events (session_id, created_at);
2026-11-02T15:34:32.1118743Z  	CREATE INDEX idx_events_rule    ON biz_events USING GIN ((payload->'rule_impact'));  -- G1 ≤3s 机制
2026-11-02T15:34:32.1118977Z  	
2026-11-02T15:34:32.1119097Z  	-- append-only 防改写触发器（L1.1：回滚/删除均为新事件，原事件永不修改）
2026-11-02T15:34:32.1119308Z  	CREATE OR REPLACE FUNCTION workloom_no_mutate() RETURNS trigger AS $$
2026-11-02T15:34:32.1119504Z  	BEGIN
2026-11-02T15:34:32.1119683Z  	  RAISE EXCEPTION 'biz_events is append-only: % not allowed (PRD L1.1)', TG_OP;
2026-11-02T15:34:32.1119892Z  	END;
2026-11-02T15:34:32.1120000Z  	$$ LANGUAGE plpgsql;
2026-11-02T15:34:32.1120121Z  	
2026-11-02T15:34:32.1120357Z  	CREATE TRIGGER trg_biz_events_no_update
2026-11-02T15:34:32.1120576Z  	  BEFORE UPDATE ON biz_events FOR EACH ROW EXECUTE FUNCTION workloom_no_mutate();
2026-11-02T15:34:32.1120802Z  	CREATE TRIGGER trg_biz_events_no_delete
2026-11-02T15:34:32.1121155Z  	  BEFORE DELETE ON biz_events FOR EACH ROW EXECUTE FUNCTION workloom_no_mutate();
2026-11-02T15:34:32.1121362Z  	
2026-11-02T15:34:32.1121516Z  	CREATE TABLE org_memory (                                             -- 组织统一记忆（F1.4）
2026-11-02T15:34:32.1121811Z  	  memory_id      TEXT PRIMARY KEY,
2026-11-02T15:34:32.1121960Z  	  tenant_id      TEXT NOT NULL,
2026-11-02T15:34:32.1122107Z  	  workspace_id   TEXT NOT NULL,
2026-11-02T15:34:32.1122293Z  	  scope          TEXT NOT NULL CHECK (scope IN ('workspace','agent','run')),
2026-11-02T15:34:32.1122566Z  	  kind           TEXT NOT NULL CHECK (kind IN ('preference','pattern','sop','forbidden')),
2026-11-02T15:34:32.1122840Z  	  content        TEXT NOT NULL,                                       -- 脱敏后的模式化结论（F1.8）
2026-11-02T15:34:32.1123054Z  	  embedding      vector(1536),
2026-11-02T15:34:32.1123257Z  	  source_events  TEXT[] NOT NULL DEFAULT '{}',                        -- 来源事件（归因）
2026-11-02T15:34:32.1123477Z  	  confidence     REAL NOT NULL DEFAULT 0.5,
2026-11-02T15:34:32.1123652Z  	  status         TEXT NOT NULL DEFAULT 'active'
2026-11-02T15:34:32.1123844Z  	                 CHECK (status IN ('active','superseded','recalled')),
2026-11-02T15:34:32.1124052Z  	  created_at     TIMESTAMPTZ NOT NULL DEFAULT now()
2026-11-02T15:34:32.1124213Z  	);
2026-11-02T15:34:32.1124388Z  	CREATE INDEX idx_memory_ws_scope ON org_memory (workspace_id, scope, status);
2026-11-02T15:34:32.1124597Z  	
2026-11-02T15:34:32.1124757Z  	CREATE TABLE memory_usage (                                           -- 记忆使用归因（F1.4）
2026-11-02T15:34:32.1125000Z  	  memory_id  TEXT NOT NULL REFERENCES org_memory(memory_id),
2026-11-02T15:34:32.1125184Z  	  event_id   TEXT NOT NULL,
2026-11-02T15:34:32.1125335Z  	  used_at    TIMESTAMPTZ NOT NULL DEFAULT now(),
2026-11-02T15:34:32.1125514Z  	  PRIMARY KEY (memory_id, event_id)
2026-11-02T15:34:32.1125653Z  	);
