2026-11-02T15:34:32.1128432Z  	  is_baseline       BOOLEAN NOT NULL DEFAULT false,                   -- 单调守卫（F2.3）
2026-11-02T15:34:32.1128655Z  	  status            TEXT NOT NULL DEFAULT 'draft'
2026-11-02T15:34:32.1128875Z  	                    CHECK (status IN ('draft','pending_approval','active','rolled_back')),
2026-11-02T15:34:32.1129092Z  	  created_by        TEXT NOT NULL,
