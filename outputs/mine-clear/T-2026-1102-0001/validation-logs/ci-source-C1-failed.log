2026-11-02T15:34:32.1089100Z  	  threads, approvals, night_runs, triggers,
2026-11-02T15:34:32.1089282Z  	  skills, skill_installs, industry_assets, credentials
2026-11-02T15:34:32.1089451Z  	TO workloom_app;
2026-11-02T15:34:32.1089581Z  	GRANT SELECT ON biz_events TO workloom_app;
2026-11-02T15:34:32.1089738Z  	
2026-11-02T15:34:32.1089851Z  	GRANT SELECT, INSERT, UPDATE, DELETE ON
2026-11-02T15:34:32.1090023Z  	  tenants, workspaces, members, agents, profiles,
2026-11-02T15:34:32.1090211Z  	  org_memory, memory_usage, fence_rules, fence_dry_runs,
2026-11-02T15:34:32.1090397Z  	  threads, approvals, night_runs, triggers,
2026-11-02T15:34:32.1090577Z  	  skills, skill_installs, industry_assets, credentials
2026-11-02T15:34:32.1090752Z  	TO workloom_gateway;
2026-11-02T15:34:32.1091146Z  	GRANT SELECT, INSERT ON biz_events TO workloom_gateway;
2026-11-02T15:34:32.1091468Z  	GRANT USAGE, SELECT ON SEQUENCE biz_events_seq_seq TO workloom_gateway; -- bigserial 列名 seq → 序列名 biz_events_seq_seq
