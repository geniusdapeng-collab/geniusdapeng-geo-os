2026-11-02T15:34:32.1103023Z  	CREATE EXTENSION IF NOT EXISTS vector;
2026-11-02T15:34:32.1103166Z  	
2026-11-02T15:34:32.1103270Z  	-- ---------- 组织模型（M7） ----------
2026-11-02T15:34:32.1103409Z  	
2026-11-02T15:34:32.1103512Z  	CREATE TABLE tenants (
2026-11-02T15:34:32.1103648Z  	  id          TEXT PRIMARY KEY,
