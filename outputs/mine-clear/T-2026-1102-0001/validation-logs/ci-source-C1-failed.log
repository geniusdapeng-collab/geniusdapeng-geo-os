2026-11-02T15:34:32.1172075Z  	-- RLS 行级隔离（F7.1）：按 app.workspace_id / app.tenant_id 连接级设置过滤；
2026-11-02T15:34:32.1172270Z  	-- 未设置时所有行不可见（安全默认值）；越权查询返回空而非 403（L7.1）。
2026-11-02T15:34:32.1172440Z  	-- 注：表 owner（迁移/种子账号）默认绕过策略；FORCE RLS 进停车场（总纲 §7）。
2026-11-02T15:34:32.1172618Z  	-- memory_usage / skills 为全局引用表，由服务层按键控权，不设 RLS。
2026-11-02T15:34:32.1172802Z  	-- ============================================================================
2026-11-02T15:34:32.1172968Z  	DO $$
2026-11-02T15:34:32.1173074Z  	DECLARE t TEXT;
2026-11-02T15:34:32.1173187Z  	BEGIN
2026-11-02T15:34:32.1173298Z  	  FOREACH t IN ARRAY ARRAY[
2026-11-02T15:34:32.1173501Z  	    'members','agents','profiles','biz_events','org_memory','fence_dry_runs',
2026-11-02T15:34:32.1173750Z  	    'threads','approvals','night_runs','triggers','skill_installs',
2026-11-02T15:34:32.1173952Z  	    'industry_assets','credentials'
2026-11-02T15:34:32.1174094Z  	  ] LOOP
2026-11-02T15:34:32.1174245Z  	    EXECUTE format('ALTER TABLE %I ENABLE ROW LEVEL SECURITY', t);
2026-11-02T15:34:32.1174434Z  	    EXECUTE format(
2026-11-02T15:34:32.1174776Z  	      'CREATE POLICY p_%I_ws ON %I USING (workspace_id = current_setting(''app.workspace_id'', true)) WITH CHECK (workspace_id = current_setting(''app.workspace_id'', true))',
2026-11-02T15:34:32.1175147Z  	      t, t, t);
2026-11-02T15:34:32.1175259Z  	  END LOOP;
2026-11-02T15:34:32.1175368Z  	END $$;
2026-11-02T15:34:32.1175470Z  	
2026-11-02T15:34:32.1175600Z  	ALTER TABLE fence_rules ENABLE ROW LEVEL SECURITY;
2026-11-02T15:34:32.1175784Z  	CREATE POLICY p_fence_rules_ws ON fence_rules
2026-11-02T15:34:32.1176034Z  	  USING (workspace_id = current_setting('app.workspace_id', true) OR workspace_id = '*')
2026-11-02T15:34:32.1176356Z  	  WITH CHECK (workspace_id = current_setting('app.workspace_id', true) OR workspace_id = '*');
2026-11-02T15:34:32.1176590Z  	
2026-11-02T15:34:32.1176716Z  	ALTER TABLE workspaces ENABLE ROW LEVEL SECURITY;
2026-11-02T15:34:32.1176899Z  	CREATE POLICY p_workspaces_ws ON workspaces
2026-11-02T15:34:32.1177082Z  	  USING (id = current_setting('app.workspace_id', true)
2026-11-02T15:34:32.1177294Z  	         OR tenant_id = current_setting('app.tenant_id', true))
2026-11-02T15:34:32.1177512Z  	  WITH CHECK (tenant_id = current_setting('app.tenant_id', true));
2026-11-02T15:34:32.1177694Z  	
2026-11-02T15:34:32.1177812Z  	ALTER TABLE tenants ENABLE ROW LEVEL SECURITY;
2026-11-02T15:34:32.1177985Z  	CREATE POLICY p_tenants_tenant ON tenants
2026-11-02T15:34:32.1178159Z  	  USING (id = current_setting('app.tenant_id', true))
2026-11-02T15:34:32.1178359Z  	  WITH CHECK (id = current_setting('app.tenant_id', true));
