{
  "name": "pengmanager-system",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "description": "鹏经理系统（PengManager System）：李大鹏的个人 GEO、内容与社媒经营控制面",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "video:setup": "node scripts/video-setup.mjs",
    "video:doctor": "node scripts/video-doctor.mjs",
    "video:start": "node scripts/video-start.mjs",
    "agent": "node scripts/agent.mjs",
    "mcp": "node scripts/agent-mcp.mjs",
    "video:status": "node scripts/agent.mjs status",
    "video:capabilities": "node scripts/agent.mjs capabilities",
    "test": "node --test tests/*.test.mjs",
    "test:engines": "node --test engines/geo-evidence/test/*.test.mjs tests/integrated-engines.test.mjs",
    "check": "node --check src/server.mjs && node --check public/app.js",
    "acceptance": "node scripts/acceptance.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:vendor": "node --test --test-concurrency=1 engines/video-edit/bundles/ai-video/connectors/post-bridge/*.test.mjs && vitest run --maxWorkers=1 --minWorkers=1 --no-file-parallelism engines/video-edit/bundles/ai-video/connectors/cover-kb-bridge/core.test.ts engines/video-edit/bundles/ai-video/connectors/post-bridge/delivery-integration.test.ts engines/video-edit/bundles/ai-video/connectors/post-bridge/post-cli-media.test.ts engines/video-edit/bundles/ai-video/connectors/post-bridge/revision-concurrency.test.ts",
    "test:ci": "node --test --test-concurrency=1 engines/video-edit/bundles/ai-video/connectors/post-bridge/*.test.mjs && vitest run --maxWorkers=1 --minWorkers=1 --no-file-parallelism engines/video-edit/bundles/ai-video/connectors/cover-kb-bridge/core.test.ts",
    "live:deepseek": "node scripts/live-deepseek-collect.mjs",
    "live:geoevidence": "node scripts/live-geoevidence.mjs",
    "live:video-edit": "node scripts/live-video-edit.mjs",
    "live:github": "node scripts/live-github-publish.mjs",
    "live:media": "node scripts/live-media-render.mjs",
    "live:geo": "node scripts/live-geo-integrated.mjs"
  },
  "devDependencies": {
    "tsx": "4.23.12",
    "vitest": "3.2.0",
    "yaml": "2.9.0",
    "zod": "4.6.5"
  },
  "license": "UNLICENSED"
}
