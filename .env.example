HOST=127.0.0.1
PORT=4318
ALLOWED_HOSTS=127.0.0.1,localhost,::1
DATA_FILE=var/state.json
# Unified text-model dispatch. All text generation and independent review resolve
# to the same registered model. Thinking mode is selected by scene policy.
LLM_PROVIDER=deepseek
LLM_BASE_URL=http://127.0.0.1:8788
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# Embedded video engine only: leave blank to use scene policy. Set to
# enabled/disabled only as a reviewed deployment-wide rollback switch.
LLM_THINKING_TYPE=
# Compatibility aliases accepted only by the migration boundary:
DEEPSEEK_BASE_URL=http://127.0.0.1:8788
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_AUTH_COMMAND=
GITHUB_TOKEN=
GITHUB_REPOSITORY=geniusdapeng-collab/geniusdapeng-geo-os
GEO_EVIDENCE_BASE_URL=http://127.0.0.1:4317
GEO_EVIDENCE_TOKEN=
# Embedded video runtime owns its own loopback services and private data.
# Leave DATA_DIR empty for the OS-specific private default outside this repository.
PENGMANAGER_VIDEO_DATA_DIR=
PENGMANAGER_POSTGRES_HOME=
PENGMANAGER_VIDEO_PG_PORT=16432
PENGMANAGER_VIDEO_BACKEND_PORT=18797
PENGMANAGER_VIDEO_WEB_PORT=14318
# CLI/MCP is the default; set to 1 only when the optional built workbench is needed.
PENGMANAGER_VIDEO_WORKBENCH=0
# Explicit setup downloads the pinned official public UI release without credentials.
GEO_ENGINE_DB=
WL_FFMPEG=ffmpeg
WL_FFPROBE=ffprobe

# WorkLoom PM cloud assistant launch. The private key is injected only at
# runtime; never commit or print it. Public WorkLoom receives only the public
# key and a 60-second, one-time signed launch code.
WORKLOOM_PM_ORIGIN=https://pm.pengmanager.com
WORKLOOM_LAUNCH_TENANT_ID=demo
WORKLOOM_LAUNCH_WORKSPACE_ID=ws-aipm-demo
WORKLOOM_LAUNCH_MEMBER_NO=MEM-001
WORKLOOM_LAUNCH_TTL_SECONDS=60
# WORKLOOM_LAUNCH_PRIVATE_KEY_B64=<base64-encoded-ed25519-private-key-pem>
# Alternatively provide WORKLOOM_LAUNCH_PRIVATE_KEY with an escaped PEM value.
